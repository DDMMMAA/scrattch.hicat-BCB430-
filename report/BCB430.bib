@article{szadvari_sex_2023,
	title = {Sex differences matter: Males and females are equal but not the same},
	volume = {259},
	issn = {0031-9384},
	url = {https://www.sciencedirect.com/science/article/pii/S0031938422003420},
	doi = {10.1016/j.physbeh.2022.114038},
	shorttitle = {Sex differences matter},
	abstract = {Sex differences between males and females can be detected early in life. They are present also later even to a much greater extent affecting our life in adulthood and a wide spectrum of physical, psychological, cognitive, and behavioral characteristics. Moreover, sex differences matter also in individual's health and disease. In this article, we reviewed at first the sex differences in brain organization and function with respect to the underlying biological mechanisms. Since the individual functional differences in the brain, in turn, shape the behavior, sex-specific psychological/behavioral differences that can be observed in infants but also adults are consequently addressed. Finally, we briefly mention sex-dependent variations in susceptibility to selected disorders as well as their pathophysiology, diagnosis, and response to therapy. The understanding of biologically determined variability between males and females can have important implications, especially in gender-specific health care. We have the impression that it is very important to emphasize that sex matters. Males and females are differently programmed by nature, and it must be respected. Even though we as males and females are not the same, we would like to emphasize that we are still equal and together form a worthy colorful continuum.},
	pages = {114038},
	journaltitle = {Physiology \& Behavior},
	shortjournal = {Physiology \& Behavior},
	author = {Szadvári, Ivan and Ostatníková, Daniela and Babková Durdiaková, Jaroslava},
	urldate = {2025-10-10},
	date = {2023-02-01},
	keywords = {Brain, Heterogeneity, Hormones, Sex differences, Sex-specific medicine},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\16706\\Zotero\\storage\\V9YCBN62\\Szadvári et al. - 2023 - Sex differences matter Males and females are equal but not the same.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\16706\\Zotero\\storage\\G2WF39EX\\S0031938422003420.html:text/html},
}

